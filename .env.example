# Copy to .env.local and fill in. .env.local is gitignored.
# Nothing here has a working default that reaches a real service.

# --- database ---------------------------------------------------------------
# Any Postgres 15+. Supabase, RDS, a container, your laptop.
#
# If you are on Supabase, use the SESSION-mode pooler (port 5432) rather than
# the direct host: the direct one is IPv6-only without the paid IPv4 add-on and
# simply fails to resolve on most machines. Transaction mode (6543) works too,
# and Zarvis disables prepared statements automatically when it sees that port.
ZARVIS_DATABASE_URL=postgresql://zarvis_agent:PASSWORD@HOST:5432/postgres

# Created by the first migration. `select id from zarvis.workspace;`
ZARVIS_WORKSPACE_ID=

# --- google -----------------------------------------------------------------
# A service account with domain-wide delegation, NOT an OAuth client.
#
# An OAuth client in Testing status issues refresh tokens that expire after
# seven days, which is a trap on an always-on machine: it works all week and
# dies on the weekend.
#
# Keep the key file OUTSIDE the repository. It can impersonate any user in the
# Workspace domain.
ZARVIS_GOOGLE_SA_KEY_PATH=/absolute/path/outside/this/repo/service-account.json

# The mailbox Zarvis reads and writes drafts into. Yours.
ZARVIS_GOOGLE_IMPERSONATE=you@example.com

# --- model ------------------------------------------------------------------
# provider: "xai" | "openai" | "anthropic" | any OpenAI-compatible endpoint
ZARVIS_LLM_PROVIDER=xai
ZARVIS_LLM_MODEL=grok-4.5
ZARVIS_LLM_API_KEY=
# Only for an OpenAI-compatible endpoint that is not the vendor's own:
# ZARVIS_LLM_BASE_URL=https://your-gateway.example.com/v1

# Per-provider keys, so a bake-off can run several at once without swapping:
# ZARVIS_LLM_API_KEY_OPENAI=
# ZARVIS_LLM_API_KEY_ANTHROPIC=

# --- safety -----------------------------------------------------------------
# Print everything, write nothing. Run every new module this way first.
ZARVIS_DRY_RUN=0

# Stop the scheduled run without unregistering it.
ZARVIS_KILL_SWITCH=0

# Abort a run that would spend more than this. A guard against a loop, not a
# budget: normal days come in far under it.
ZARVIS_COST_CEILING_USD=2.00

# --- queue shape ------------------------------------------------------------
# How many make the drafted tier, the visible tier, and the collapsed tier.
# Everything below is still scored and kept, just hidden.
ZARVIS_TIER_PRIORITY=5
ZARVIS_TIER_STANDARD=10
ZARVIS_TIER_BACKLOG=25

# Never contact the same person twice inside this many days, whatever the score
# says. The ranking has no memory of how it feels to be on the other end.
ZARVIS_MIN_DAYS_BETWEEN_TOUCHES=7

# --- optional sources -------------------------------------------------------
# ZARVIS_FIREFLIES_API_KEY=
# ZARVIS_SLACK_BOT_TOKEN=
# ZARVIS_NOTION_TOKEN=

# --- optional: synthetic addresses -----------------------------------------
# If the system you ingest from manufactures placeholder email addresses for
# accounts that never gave a real one, list those domains here and Zarvis will
# stop paying Gmail quota to search for addresses that cannot exist.
#
# Leave empty unless you know you have this problem.
# ZARVIS_SYNTHETIC_EMAIL_DOMAINS=placeholder.example.com,managed.example.internal

# --- optional: dead man's switch -------------------------------------------
# Pinged on a successful run. If it stops being pinged, you find out that the
# morning run has been silently failing.
# ZARVIS_HEARTBEAT_URL=
